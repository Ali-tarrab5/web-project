<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Velour | Product Catalog</title>

  <!-- Reuse your existing style.css -->
  <link rel="stylesheet" href="/style.css" />

  <style>
    /* ── Page-specific overrides ─────────────────────────────────────── */
    body { background-color: #0f172a; color: #f8fafc; }

    /* ── Navbar ──────────────────────────────────────────────────────── */
    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.2rem 5%;
      background: rgba(15,23,42,0.95);
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(148,163,184,0.12);
    }
    .logo-text {
      font-size: 1.6rem;
      font-weight: 800;
      color: #6366f1;
      text-decoration: none;
      letter-spacing: -0.5px;
    }
    .nav-home {
      color: #94a3b8;
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.2s;
    }
    .nav-home:hover { color: #f8fafc; }

    /* ── Catalog wrapper ─────────────────────────────────────────────── */
    .catalog-container {
      max-width: 1300px;
      margin: 2.5rem auto;
      padding: 0 5%;
    }

    /* ── Header row ──────────────────────────────────────────────────── */
    .catalog-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1.8rem;
    }
    .catalog-header h1 {
      font-size: 2.4rem;
      font-weight: 800;
      background: linear-gradient(135deg, #6366f1, #a78bfa);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .product-summary { color: #64748b; font-size: 0.9rem; }

    /* ── Filter form ─────────────────────────────────────────────────── */
    .filter-form {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      align-items: flex-end;
      background: #1e293b;
      border: 1px solid rgba(148,163,184,0.15);
      border-radius: 14px;
      padding: 1.4rem;
      margin-bottom: 2rem;
    }
    .filter-group {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      flex: 1;
      min-width: 140px;
    }
    .filter-group label {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #64748b;
      font-weight: 700;
    }
    .filter-group input,
    .filter-group select {
      background: #0f172a;
      border: 1px solid rgba(148,163,184,0.2);
      border-radius: 8px;
      color: #f8fafc;
      padding: 0.6rem 0.85rem;
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.2s;
    }
    .filter-group input:focus,
    .filter-group select:focus  { border-color: #6366f1; }
    .filter-group select option { background: #1e293b; }
    .filter-group input::placeholder { color: #475569; }

    .filter-actions {
      display: flex;
      gap: 0.6rem;
      align-items: flex-end;
      padding-bottom: 1px;
    }
    .btn {
      padding: 0.6rem 1.3rem;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 700;
      cursor: pointer;
      border: none;
      text-decoration: none;
      display: inline-block;
      transition: opacity 0.2s, transform 0.15s;
    }
    .btn:hover  { opacity: 0.85; transform: translateY(-1px); }
    .btn:active { transform: translateY(0); }
    .btn-primary   { background: #6366f1; color: #fff; }
    .btn-secondary {
      background: transparent;
      color: #94a3b8;
      border: 1px solid rgba(148,163,184,0.3);
    }
    .btn-secondary:hover { border-color: #6366f1; color: #f8fafc; }

    /* ── Product grid ────────────────────────────────────────────────── */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1.25rem;
    }

    .product-card {
      background: #1e293b;
      border: 1px solid rgba(148,163,184,0.12);
      border-radius: 16px;
      padding: 1.4rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    }
    .product-card:hover {
      border-color: #6366f1;
      transform: translateY(-4px);
      box-shadow: 0 10px 30px rgba(99,102,241,0.15);
    }

    /* Badge */
    .badge {
      display: inline-block;
      padding: 0.28rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      background: rgba(99,102,241,0.15);
      color: #c7d2fe;
      align-self: flex-start;
    }

    .product-name {
      font-size: 1rem;
      font-weight: 700;
      color: #f1f5f9;
      line-height: 1.35;
    }

    /* Stars */
    .stars { display: flex; align-items: center; gap: 2px; }
    .star-full  { color: #facc15; }
    .star-empty { color: #334155; }
    .rating-num { font-size: 0.78rem; color: #64748b; margin-left: 5px; }

    /* Meta row */
    .meta-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: auto;
    }
    .price  { font-size: 1.3rem; font-weight: 800; color: #f8fafc; }
    .stock  { font-size: 0.78rem; font-weight: 600; color: #4ade80; }
    .stock.low { color: #fb923c; }
    .stock.out { color: #f87171; }

    /* ── Empty state ─────────────────────────────────────────────────── */
    .empty-state {
      text-align: center;
      padding: 5rem 1rem;
      color: #475569;
    }
    .empty-state .icon { font-size: 3.5rem; display: block; margin-bottom: 1rem; }
    .empty-state h2 { font-size: 1.4rem; color: #94a3b8; margin-bottom: 0.5rem; }
    .empty-state p  { margin-bottom: 1.5rem; }

    /* ── Pagination ──────────────────────────────────────────────────── */
    .pagination {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: 2.5rem;
      padding-bottom: 3rem;
    }
    .page-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 42px;
      height: 42px;
      padding: 0 0.9rem;
      border-radius: 10px;
      border: 1px solid rgba(148,163,184,0.2);
      color: #cbd5e1;
      text-decoration: none;
      background: #1e293b;
      font-size: 0.9rem;
      font-weight: 600;
      transition: all 0.2s;
    }
    .page-btn:hover:not(.disabled):not(.active) {
      border-color: #6366f1;
      color: #a5b4fc;
    }
    .page-btn.active {
      background: #6366f1;
      border-color: #6366f1;
      color: #fff;
    }
    .page-btn.disabled {
      opacity: 0.3;
      cursor: not-allowed;
      pointer-events: none;
    }
    .page-info {
      text-align: center;
      color: #475569;
      font-size: 0.82rem;
      margin-top: 0.6rem;
      padding-bottom: 1rem;
    }

    /* ── Footer ──────────────────────────────────────────────────────── */
    footer {
      text-align: center;
      padding: 2rem;
      border-top: 1px solid #1e293b;
      color: #475569;
    }

    /* ── Responsive ──────────────────────────────────────────────────── */
    @media (max-width: 768px) {
      .filter-form    { flex-direction: column; }
      .filter-group   { min-width: 100%; }
      .filter-actions { width: 100%; }
      .catalog-header h1 { font-size: 1.8rem; }
    }
  </style>
</head>
<body>

<!-- ══════════════════ NAVBAR ══════════════════════════════════════════════ -->
<header class="navbar">
  <a href="/" class="logo-text">Velour.</a>
  <a href="/" class="nav-home">← Back to Home</a>
</header>

<!-- ══════════════════ CATALOG ════════════════════════════════════════════ -->
<main class="catalog-container">

  <!-- Header -->
  <div class="catalog-header">
    <h1>Product Catalog</h1>
    <p class="product-summary">
      Showing
      <strong><%= products.length %></strong>
      of
      <strong><%= pagination.totalProducts %></strong>
      products
    </p>
  </div>

  <!-- ── Filter Form ──────────────────────────────────────────────────── -->
  <form class="filter-form" method="GET" action="/products">

    <!-- Search -->
    <div class="filter-group">
      <label for="search">Search</label>
      <input
        type="text"
        id="search"
        name="search"
        placeholder="Search by name..."
        value="<%= filters.search %>"
      />
    </div>

    <!-- Category -->
    <div class="filter-group">
      <label for="category">Category</label>
      <select id="category" name="category">
        <option value="">All Categories</option>
        <% categories.forEach(function(cat) { %>
          <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>>
            <%= cat %>
          </option>
        <% }); %>
      </select>
    </div>

    <!-- Min Price -->
    <div class="filter-group">
      <label for="minPrice">Min Price ($)</label>
      <input
        type="number"
        id="minPrice"
        name="minPrice"
        placeholder="0"
        min="0"
        step="0.01"
        value="<%= filters.minPrice %>"
      />
    </div>

    <!-- Max Price -->
    <div class="filter-group">
      <label for="maxPrice">Max Price ($)</label>
      <input
        type="number"
        id="maxPrice"
        name="maxPrice"
        placeholder="Any"
        min="0"
        step="0.01"
        value="<%= filters.maxPrice %>"
      />
    </div>

    <!-- Sort -->
    <div class="filter-group">
      <label for="sort">Sort By</label>
      <select id="sort" name="sort">
        <option value="name_asc"    <%= filters.sort === 'name_asc'    ? 'selected' : '' %>>Name (A–Z)</option>
        <option value="name_desc"   <%= filters.sort === 'name_desc'   ? 'selected' : '' %>>Name (Z–A)</option>
        <option value="price_asc"   <%= filters.sort === 'price_asc'   ? 'selected' : '' %>>Price: Low → High</option>
        <option value="price_desc"  <%= filters.sort === 'price_desc'  ? 'selected' : '' %>>Price: High → Low</option>
        <option value="rating_desc" <%= filters.sort === 'rating_desc' ? 'selected' : '' %>>Top Rated</option>
      </select>
    </div>

    <!-- Buttons -->
    <div class="filter-actions">
      <button type="submit" class="btn btn-primary">Apply</button>
      <a href="/products" class="btn btn-secondary">Reset</a>
    </div>

  </form>

  <!-- ── Product Grid ─────────────────────────────────────────────────── -->
  <% if (products.length === 0) { %>

    <div class="empty-state">
      <span class="icon">🔍</span>
      <h2>No products found</h2>
      <p>Try adjusting your search or filter criteria.</p>
      <a href="/products" class="btn btn-primary">Clear Filters</a>
    </div>

  <% } else { %>

    <div class="cards-grid">
      <% products.forEach(function(product) { %>
        <div class="product-card">

          <!-- Category badge -->
          <span class="badge"><%= product.category %></span>

          <!-- Name -->
          <h3 class="product-name"><%= product.name %></h3>

          <!-- Star rating -->
          <div class="stars">
            <% for (let i = 1; i <= 5; i++) { %>
              <% if (i <= Math.round(product.rating)) { %>
                <span class="star-full">★</span>
              <% } else { %>
                <span class="star-empty">★</span>
              <% } %>
            <% } %>
            <span class="rating-num">(<%= product.rating %>)</span>
          </div>

          <!-- Price & Stock -->
          <div class="meta-row">
            <span class="price">$<%= product.price.toFixed(2) %></span>
            <% if (product.stock === 0) { %>
              <span class="stock out">Out of stock</span>
            <% } else if (product.stock < 10) { %>
              <span class="stock low">⚠ Only <%= product.stock %> left</span>
            <% } else { %>
              <span class="stock">✔ <%= product.stock %> in stock</span>
            <% } %>
          </div>

        </div>
      <% }); %>
    </div>

  <% } %>

  <!-- ── Pagination ───────────────────────────────────────────────────── -->
  <%
    // Helper to build query string preserving filters
    function buildQuery(p) {
      const q = new URLSearchParams();
      q.set('page', p);
      if (filters.search)   q.set('search',   filters.search);
      if (filters.category) q.set('category', filters.category);
      if (filters.minPrice) q.set('minPrice', filters.minPrice);
      if (filters.maxPrice) q.set('maxPrice', filters.maxPrice);
      if (filters.sort)     q.set('sort',     filters.sort);
      return '/products?' + q.toString();
    }
  %>

  <% if (pagination.totalPages > 1) { %>
    <nav class="pagination" aria-label="Product pages">

      <!-- Previous -->
      <% if (pagination.page > 1) { %>
        <a href="<%= buildQuery(pagination.page - 1) %>" class="page-btn">← Prev</a>
      <% } else { %>
        <span class="page-btn disabled">← Prev</span>
      <% } %>

      <!-- Page numbers -->
      <% pageNumbers.forEach(function(p) { %>
        <% if (p === pagination.page) { %>
          <span class="page-btn active"><%= p %></span>
        <% } else { %>
          <a href="<%= buildQuery(p) %>" class="page-btn"><%= p %></a>
        <% } %>
      <% }); %>

      <!-- Next -->
      <% if (pagination.page < pagination.totalPages) { %>
        <a href="<%= buildQuery(pagination.page + 1) %>" class="page-btn">Next →</a>
      <% } else { %>
        <span class="page-btn disabled">Next →</span>
      <% } %>

    </nav>

    <p class="page-info">
      Page <strong><%= pagination.page %></strong>
      of
      <strong><%= pagination.totalPages %></strong>
    </p>
  <% } %>

</main>

<footer>
  <p>&copy; 2026 Velour Technologies. All rights reserved.</p>
</footer>

</body>
</html>
