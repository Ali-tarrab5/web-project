<%- include('admin_header', { title: title, active: active }) %>

<% if (errors && errors.length) { %>
    <div class="admin-notice">
        <ul>
            <% errors.forEach((error) => { %>
                <li><%= error %></li>
            <% }) %>
        </ul>
    </div>
<% } %>

<form class="admin-form" method="post" action="<%= formAction %>" enctype="multipart/form-data">
    <div class="form-row">
        <div>
            <label for="name">Product Name</label>
            <input id="name" name="name" type="text" value="<%= product.name || '' %>" required />
        </div>
        <div>
            <label for="category">Category</label>
            <input id="category" name="category" type="text" value="<%= product.category || '' %>" required />
        </div>
    </div>

    <div class="form-row">
        <div>
            <label for="price">Price</label>
            <input id="price" name="price" type="number" step="0.01" min="0" value="<%= product.price || '' %>" required />
        </div>
        <div>
            <label for="stock">Stock</label>
            <input id="stock" name="stock" type="number" step="1" min="0" value="<%= product.stock || '' %>" required />
        </div>
    </div>

    <div class="form-row">
        <div>
            <label for="rating">Rating</label>
            <input id="rating" name="rating" type="number" step="0.1" min="0" max="5" value="<%= product.rating || '' %>" required />
        </div>
        <div>
            <label for="image">Image Upload</label>
            <input id="image" name="image" type="file" accept="image/*" />
            <input type="hidden" name="existingImageUrl" value="<%= product.imageUrl || '' %>" />
        </div>
    </div>

    <% if (product.imageUrl) { %>
        <div style="display:flex; gap:1rem; flex-wrap:wrap; align-items:center; margin-bottom:1rem;">
            <div>
                <label>Current Image</label>
                <img src="<%= product.imageUrl %>" alt="Current Image" class="preview-image" />
            </div>
        </div>
    <% } %>

    <button class="cta-btn-small" type="submit"><%= title.includes('Add') ? 'Create Product' : 'Save Changes' %></button>
</form>

<%- include('admin_footer') %>
